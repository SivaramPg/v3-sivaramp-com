---
const { title } = Astro.props

const slug = title
  .toLowerCase()
  .replace(/&/g, 'and')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '')
---

<h2
  id={slug}
  class="font-display text-3xl md:text-4xl font-bold whitespace-nowrap scroll-mt-8"
>
  <a
    href={`#${slug}`}
    class="group flex items-baseline gap-2 hover:underline underline-offset-8 decoration-2"
  >
    <span
      class="text-gray-300 dark:text-gray-700 group-hover:text-gray-500 dark:group-hover:text-gray-400 transition-colors select-none"
      aria-hidden="true">#</span
    >
    {title}
  </a>
</h2>
