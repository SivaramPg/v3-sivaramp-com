---
import { Icon } from 'astro-icon/components'

const links = [
  { href: 'https://github.com/SivaramPg', label: 'GitHub', icon: 'simple-icons:github' },
  { href: 'https://www.linkedin.com/in/sivaram-p/', label: 'LinkedIn', icon: 'simple-icons:linkedin' },
  { href: 'https://blog.sivaramp.com/', label: 'Blog', icon: 'simple-icons:rss' },
  { href: 'https://sivarampg.medium.com/', label: 'Medium', icon: 'simple-icons:medium' },
  { href: 'https://dev.to/sivarampg', label: 'DEV Community', icon: 'simple-icons:devdotto' },
  { href: 'https://x.com/SivaramPg', label: 'X (Twitter)', icon: 'simple-icons:x' },
  { href: 'mailto:dev.sivaramp@gmail.com', label: 'Email Address', icon: 'email' },
]
---

<footer
  class="min-h-32 flex items-center justify-between flex-wrap max-w-5xl mx-auto px-4"
>
  <p class="text-sm sm:text-base md:text-lg font-medium">
    Made with ❤️ by Sivaram Pandariganthan © {new Date().getFullYear()}
  </p>

  <section class="flex gap-8 items-center flex-wrap">
    {
      links.map(({ href, label, icon }) => (
        <a
          target="_blank"
          href={href}
          aria-label={label}
          class="text-gray-900 dark:text-gray-100"
        >
          <Icon name={icon} class="w-5 h-5 md:w-6 md:h-6" aria-hidden="true" />
        </a>
      ))
    }
  </section>
</footer>
