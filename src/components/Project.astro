---
import { getImage, Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { statusBadge, statusTint } from '../lib/statusBadge'
import { techIcon, techTint } from '../lib/techIcons'

interface Link {
  href: string
  label: string
  icon: string
}

const {
  image,
  imageAlt,
  iconUrl,
  title,
  description,
  highlights = [],
  stack = [],
  repoUrl,
  websiteUrl,
  websiteLabel = 'Visit Website',
  status,
  extraLinks = [],
} = Astro.props

// Pick a link icon from the destination; explicit `icon` on a link wins.
function linkIcon(href: string): string {
  const host = new URL(href).hostname
  if (host.endsWith('github.com')) return 'simple-icons:github'
  if (host.endsWith('npmjs.com')) return 'simple-icons:npm'
  if (host.endsWith('dev.to')) return 'simple-icons:devdotto'
  if (host.endsWith('solana.com')) return 'simple-icons:solana'
  return 'lucide:external-link'
}

const links: Link[] = [
  ...(repoUrl
    ? [{ href: repoUrl, label: 'View Repo', icon: linkIcon(repoUrl) }]
    : []),
  ...(websiteUrl
    ? [{ href: websiteUrl, label: websiteLabel, icon: linkIcon(websiteUrl) }]
    : []),
  ...extraLinks.map((link: { href: string; label: string; icon?: string }) => ({
    ...link,
    icon: link.icon ?? linkIcon(link.href),
  })),
]

// Large webp variant for the lightbox, so it never upscales the thumbnail.
const { statuses = [] } = Astro.props
const statusList: string[] = [...(status ? [status] : []), ...statuses]

const fullImage = image
  ? await getImage({
      src: image,
      format: 'webp',
      width: Math.min(image.width, 1600),
    })
  : null
---

<div class="flex w-full gap-4 md:gap-6 flex-col-reverse sm:flex-row">
  <div class="flex flex-col gap-4 w-full">
    <div class="flex flex-col gap-2 w-full">
      <div class="flex items-center gap-3 flex-wrap">
        {
          iconUrl && (
            <img
              src={iconUrl}
              alt=""
              class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg object-contain"
              loading="lazy"
              width="36"
              height="36"
            />
          )
        }
        <h4 class="font-display text-xl sm:text-2xl md:text-3xl font-bold">
          {title}
        </h4>
        {
          statusList.map((label) => (
            <div
              class="rounded-md py-1 px-2 bg-gray-300 dark:bg-gray-800 text-xs font-medium flex items-center gap-1.5"
              style={statusTint(label)}
            >
              {statusBadge(label) && (
                <Icon
                  name={statusBadge(label)!.icon}
                  class="w-3.5 h-3.5"
                  style={`color: ${statusBadge(label)!.color}`}
                />
              )}
              <span>{label}</span>
            </div>
          ))
        }
      </div>
      <p
        class="w-full whitespace-pre-line text-sm md:text-base text-gray-700 dark:text-gray-300"
      >
        {description}
      </p>
      {
        highlights.length > 0 && (
          <ul class="flex flex-col gap-2 mb-1">
            {highlights.map((highlight: string) => (
              <li class="flex gap-2 text-sm text-gray-600 dark:text-gray-400">
                <Icon
                  name="lucide:check"
                  class="w-4 h-4 shrink-0 mt-0.5 text-gray-400 dark:text-gray-500"
                  aria-hidden="true"
                />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        )
      }
      <div class="flex gap-2 flex-wrap w-full">
        {
          stack.map((item: string) => (
            <div
              class="p-2 sm:p-2 px-2 sm:px-3 leading-none font-medium rounded-lg flex items-center gap-1.5 text-xs md:text-sm bg-gray-200 dark:bg-gray-800"
              style={techTint(item)}
            >
              {techIcon(item) && (
                <img
                  src={techIcon(item)}
                  alt=""
                  class="w-3.5 h-3.5 rounded-xs object-contain"
                  loading="lazy"
                  width="14"
                  height="14"
                />
              )}
              <span class="">{item}</span>
            </div>
          ))
        }
      </div>
    </div>
    {
      !image && links.length > 0 && (
        <div class="flex gap-2 md:gap-4 items-center flex-wrap">
          {links.map(({ href, label, icon }) => (
            <a
              target="_blank"
              href={href}
              class="border rounded flex gap-2 items-center justify-center p-2 hover:shadow-md duration-100 transition-all bg-gray-50 cursor-pointer invert dark:invert-0 dark:text-black"
            >
              <Icon name={icon} class="w-4 h-4" />
              <p class="font-semibold text-sm">{label}</p>
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    image && (
      <div class="w-full sm:w-72 md:w-96 shrink-0 self-center flex flex-col gap-2">
        <Image
          src={image}
          alt={imageAlt ?? `${title} preview`}
          class="w-full aspect-[1.9/1] object-cover rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-900 cursor-zoom-in"
          loading="lazy"
          format="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 640px) 384px, 92vw"
          data-lightbox
          data-full={fullImage?.src}
        />
        {links.length > 0 && (
          <div class="grid grid-cols-2 gap-2">
            {links.map(({ href, label, icon }) => (
              <a
                target="_blank"
                href={href}
                class="odd:last:col-span-2 border rounded flex gap-2 items-center justify-center p-2 hover:shadow-md duration-100 transition-all bg-gray-50 cursor-pointer invert dark:invert-0 dark:text-black"
              >
                <Icon name={icon} class="w-4 h-4" />
                <p class="font-semibold text-sm">{label}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    )
  }
</div>
