---
import { techIcon } from '../lib/techIcons'

interface Link {
  href: string
  label: string
}

const {
  imageUrl,
  imageAlt,
  title,
  description,
  highlights = [],
  stack = [],
  repoUrl,
  websiteUrl,
  websiteLabel = 'Visit Website',
  status,
  extraLinks = [],
} = Astro.props

const links: Link[] = [
  ...(websiteUrl ? [{ href: websiteUrl, label: websiteLabel }] : []),
  ...extraLinks,
]
---

<div class="flex w-full gap-4 md:gap-6 flex-col-reverse sm:flex-row">
  <div class="flex flex-col gap-6 justify-between w-full">
    <div class="flex flex-col gap-0 w-full">
      <div class="flex items-center gap-3 flex-wrap">
        <h4 class="font-display text-xl sm:text-2xl md:text-3xl font-bold">
          {title}
        </h4>
        {
          status && (
            <div class="rounded border border-gray-400 dark:border-gray-600 py-1 px-2 bg-gray-300 dark:bg-gray-800 text-xs font-medium">
              <span>{status}</span>
            </div>
          )
        }
      </div>
      <p
        class="w-full mb-2 whitespace-pre-line text-sm md:text-base text-gray-700 dark:text-gray-300"
      >
        {description}
      </p>
      {
        highlights.length > 0 && (
          <ul class="flex flex-col gap-1.5 mb-3">
            {highlights.map((highlight: string) => (
              <li class="flex gap-2 text-sm text-gray-600 dark:text-gray-400">
                <span
                  class="font-mono text-gray-400 dark:text-gray-500 select-none shrink-0"
                  aria-hidden="true"
                >
                  →
                </span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        )
      }
      <div class="flex gap-2 flex-wrap w-full">
        {
          stack.map((item: string) => (
            <div class="p-2 sm:p-2 px-2 sm:px-3 leading-none border  font-medium rounded-lg flex items-center gap-1.5 text-xs md:text-sm bg-gray-200 dark:bg-gray-800 border-gray-400">
              {techIcon(item) && (
                <img
                  src={techIcon(item)}
                  alt=""
                  class="w-3.5 h-3.5 rounded-xs object-contain"
                  loading="lazy"
                  width="14"
                  height="14"
                />
              )}
              <span class="">{item}</span>
            </div>
          ))
        }
      </div>
    </div>
    {
      (repoUrl || links.length > 0) && (
        <div class="flex gap-2 md:gap-4 items-center flex-wrap">
          {repoUrl && (
            <a
              target="_blank"
              href={repoUrl}
              class="border rounded flex gap-2 items-center justify-center p-2 hover:shadow-md duration-100 transition-all bg-gray-50 cursor-pointer invert dark:invert-0"
            >
              <img
                src="/icons/github.svg"
                alt="Github"
                class="w-5"
                width="20"
                height="20"
              />
              <p class="font-semibold text-sm dark:text-black">View Repo</p>
            </a>
          )}
          {links.map(({ href, label }) => (
            <a
              target="_blank"
              href={href}
              class="border rounded flex gap-2 items-center justify-center p-2 hover:shadow-md duration-100 transition-all bg-gray-50 cursor-pointer invert dark:invert-0"
            >
              <img
                src="/icons/website.svg"
                alt="website"
                class="w-5"
                width="20"
                height="20"
              />
              <p class="font-semibold text-sm dark:text-black">{label}</p>
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    imageUrl && (
      <img
        src={imageUrl}
        alt={imageAlt ?? `${title} preview`}
        class="w-full sm:w-72 md:w-96 shrink-0 self-center aspect-[1.9/1] object-cover rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-900"
        loading="lazy"
        width="800"
        height="450"
      />
    )
  }
</div>
