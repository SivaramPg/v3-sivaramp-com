---

<button
  id="themeToggle"
  aria-label="Toggle dark mode"
  class="border border-gray-200 dark:border-gray-600 rounded-md shadow-xs bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100 fixed top-6 right-4 sm:relative sm:top-0 sm:right-0 z-20"
>
  <svg
    class="theme-icon sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
    ></path>
  </svg>
  <svg
    class="theme-icon moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
    ></path>
  </svg>
</button>

<style>
  #themeToggle {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    transition: scale 150ms ease-out;
  }
  #themeToggle:active {
    scale: 0.96;
  }

  /* Both icons share one grid cell and cross-fade on theme change. */
  .theme-icon {
    grid-area: 1 / 1;
    width: 30px;
    height: 30px;
    fill: currentColor;
    transition:
      opacity 300ms cubic-bezier(0.2, 0, 0, 1),
      scale 300ms cubic-bezier(0.2, 0, 0, 1),
      filter 300ms cubic-bezier(0.2, 0, 0, 1),
      rotate 250ms cubic-bezier(0.075, 0.82, 0.165, 1);
  }
  .moon,
  :global(.dark) .sun {
    opacity: 0;
  }
  :global(.dark) .moon {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .moon,
    :global(.dark) .sun {
      scale: 0.25;
      filter: blur(4px);
    }
    :global(.dark) .moon {
      scale: 1;
      filter: blur(0);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    #themeToggle:hover .theme-icon {
      rotate: 10deg;
    }
  }
</style>

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme')
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark'
    }
    return 'light'
  })()

  if (theme === 'light') {
    document.documentElement.classList.remove('dark')
  } else {
    document.documentElement.classList.add('dark')
  }

  window.localStorage.setItem('theme', theme)

  const handleToggleClick = () => {
    const element = document.documentElement

    // Freeze every color transition for the swap so the page changes in one
    // frame instead of smearing; the toggle's own icons still cross-fade.
    const freeze = document.createElement('style')
    freeze.textContent =
      '*:not(.theme-icon),*::before,*::after{transition:none!important}'
    document.head.appendChild(freeze)

    element.classList.toggle('dark')
    window.getComputedStyle(document.body).backgroundColor
    requestAnimationFrame(() => requestAnimationFrame(() => freeze.remove()))

    const isDark = element.classList.contains('dark')
    localStorage.setItem('theme', isDark ? 'dark' : 'light')
  }

  document
    .getElementById('themeToggle')
    .addEventListener('click', handleToggleClick)
</script>
