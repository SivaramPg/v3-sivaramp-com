---
import oneCentImg from '../../assets/projects/1cent.png'
import greetwalaImg from '../../assets/projects/greetwala.jpg'
import postbooImg from '../../assets/projects/postboo.png'
import ribyImg from '../../assets/projects/riby.png'
import sarathiImg from '../../assets/projects/sarathi.png'
import sentinel3Img from '../../assets/projects/sentinel3.png'
import sourcewellImg from '../../assets/projects/sourcewell.png'
import inferplaneImg from '../../assets/projects/inferplane.png'
import signalBriefImg from '../../assets/projects/signal-brief.webp'
import stackfightImg from '../../assets/projects/stackfight.png'
import varamAnalyticsImg from '../../assets/projects/varam-analytics.png'
import varamChatImg from '../../assets/projects/varam-chat.png'
import Project from '../Project.astro'
import SectionTitle from '../SectionTitle.astro'
---

<section class="flex flex-col gap-4 sm:gap-6">
  <SectionTitle title="Featured Work" />
  <div class="flex flex-col divide-y divide-gray-200 dark:divide-gray-800 [&>*]:py-8 [&>*:first-child]:pt-0 [&>*:last-child]:pb-0">
    <Project
      title="GreetWala"
      iconUrl="/projects/icons/greetwala.png"
      image={greetwalaImg}
      description="A live catalogue of AI-generated greeting cards for Indian festivals and occasions in 12 languages, with 1,520 cards across 190 collections produced and published by an automated pipeline."
      highlights={[
        'Greeting text never comes from the image model: idiomatic phrases are drafted with web search and verified by a three-model jury (2/3 majority), and generation aborts before spending if a spec carries an unverified phrase',
        'Vision-model QA on the published artifact catches broken Indic conjuncts, wrong matras and clipped text; failures regenerate idempotently, converging from 93% to 99.3% pass in two rounds',
        'Prerendered pages on Cloudflare Workers and a zero-egress Tigris image CDN serving watermarked derivatives, with clean masters kept private behind presigned downloads',
      ]}
      stack={[
        'OpenRouter',
        'Sharp',
        'TanStack Start',
        'Cloudflare Workers',
        'Hono',
        'Postgres', 'Drizzle',
        'Railway',
      ]}
      websiteUrl="https://greetwala.com"
    />
    <Project
      title="PostBoo"
      iconUrl="/projects/icons/postboo.png"
      image={postbooImg}
      status="Pre-launch"
      description="Social media scheduling across 12 platforms, with an MCP server and a typed REST API so AI agents can schedule posts as well as people."
      highlights={[
        'Two-level publish state machine on pg-boss in Postgres: an attempt row is written before every platform call, and unknown outcomes go to a verifying reconciler instead of a blind retry, because a double post is worse than a missed one',
        'Twelve providers behind one OAuth/publish interface with a normalized error taxonomy; tokens are AES-256-GCM encrypted and refreshed single-flight under row locks, since X and TikTok rotate refresh tokens on use',
        'OAuth-granted MCP access with per-plan quotas enforced by atomic conditional increments, a DNS-rebind-aware SSRF guard for Mastodon instances, and webhook-mirrored billing with out-of-order event protection',
      ]}
      stack={[
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'pg-boss',
        'MCP',
        'TanStack Start',
        'Cloudflare Workers',
      ]}
    />
    <Project
      title="Sarathi"
      iconUrl="/projects/icons/sarathi.png"
      image={sarathiImg}
      status="Pre-launch"
      description="An AI strategy studio and execution bridge for Indian intraday F&O. A trader's own TradingView alert becomes an order card in Telegram and on the web, and nothing reaches their broker until they tap Confirm."
      highlights={[
        'Compliance by construction: no custody and no autonomous mode, so the human confirm is a required step in the data model; one decide() path serves the Telegram bot, the dashboard and the expiry sweeper, and every signal, decision and fill is journaled',
        "Per-user webhooks that acknowledge inside TradingView's 3-second timeout before Telegram delivery, with dedupe, an instrument-universe gate, and envelope-encrypted broker credentials under rotatable keys",
        'A strategy-studio agent that writes and validates Pine Script v6 with batched human-in-the-loop questions and versioned diffs, billed from an idempotent prepaid-credit ledger through budget-capped per-user OpenRouter keys',
      ]}
      stack={[
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'Telegram',
        'OpenRouter',
        'Stripe',
        'Clerk',
      ]}
    />
    <Project
      title="Riby"
      iconUrl="/projects/icons/riby.png"
      image={ribyImg}
      status="Pre-launch"
      description="The pager for AI agents. An agent in Claude Code, Cursor or any MCP harness pages its human for a permission, a plan check or a steering decision; the request lands in Telegram, Discord or the dashboard, and one tap sends the answer back to the waiting agent."
      highlights={[
        'Requests block correctly where hosted tools time out: a local stdio MCP server keeps the call alive with progress notifications, and the API wakes the waiting agent with a Redis push over long-poll',
        'Safe by default: unanswered requests expire to deny after a six-hour TTL, the first answer wins atomically across every channel, and chat messages edit in place once resolved',
        'An append-only on-device ledger lets a crashed agent resume exactly where it left off, alongside device-code CLI login, hashed agent tokens, idempotent request creation and hard payload caps at the API',
      ]}
      stack={[
        'MCP',
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'Redis',
        'Telegram',
        'TanStack Start',
      ]}
      websiteUrl="https://runitby.you"
    />
    <Project
      title="Sourcewell"
      iconUrl="/projects/icons/sourcewell.png"
      image={sourcewellImg}
      status="Internal Tooling"
      description="A private, local-first research gateway that gives coding agents one loopback-only interface to five web-research providers: Context7, Exa, Firecrawl, Parallel and Tavily. It returns the evidence providers found, in full, and never writes its own summaries."
      highlights={[
        'AES-256-GCM credential vault (macOS Keychain or Docker file key) that rotates across provider keys with per-credential concurrency leases, pacing, cooldowns and stale-lease recovery',
        'Every request, execution, artifact and finding persisted in SQLite, so index views stay small and full evidence can be inspected later without a second paid provider call',
        'Near-duplicate clustering and conservative independent-source counts that never hide or rerank evidence, plus a Better Auth admin console and a Docker Compose stack bound to 127.0.0.1 behind Caddy',
      ]}
      stack={[
        'Hono',
        'oRPC',
        'SQLite', 'Drizzle',
        'Better Auth',
        'TanStack Start',
        'Docker',
      ]}
    />
    <Project
      title="InferPlane"
      iconUrl="/projects/icons/inferplane.png"
      image={inferplaneImg}
      status="In Stealth"
      description="An AI control plane for teams: governed model access, credit metering, retained LLM request logs, and audit trails across providers. Currently building in stealth."
      highlights={[
        'Append-only credits ledger with reservation/settlement lifecycle and idempotency guarantees',
        'OTLP ingestion of provider usage telemetry, with request/response artifacts archived to object storage',
        'Hardened Hono/oRPC API with org-scoped rate limiting; the control plane comes before the product surface',
      ]}
      stack={[
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'Redis',
        'Trigger.dev',
        'Stripe',
        'Cloudflare',
      ]}
    />
    <Project
      title="stackfight"
      iconUrl="/projects/icons/stackfight.png"
      image={stackfightImg}
      description="A credit-billing & AI-usage-metering platform on Cloudflare Workers, exercised in production by live agent-vs-agent games."
      highlights={[
        'Stripe-funded prepaid wallets with fail-closed webhook fulfillment and idempotent integer-microcredit ledger writes',
        'Per-call inference metering with budget-capped OpenRouter keys and automated ledger reconciliation',
        'Financial invariant auditing (balance floors, ledger conservation), an extensive test suite, and rigorous ops documentation',
      ]}
      stack={[
        'Cloudflare Workers',
        'Durable Objects',
        'Stripe',
        'OpenRouter',
        'Postgres', 'Drizzle',
      ]}
      websiteUrl="https://stackfight.sivaram.dev"
    />
    <Project
      title="1-cent-requests"
      iconUrl="/projects/icons/1cent.png"
      image={oneCentImg}
      description="A live x402 pay-per-request API marketplace: 14 crypto/web-context endpoints for AI agents at $0.01 each, settled in USDC through signed HTTP 402 exchanges. No accounts, no API keys."
      highlights={[
        'Full x402 v2 resource-server implementation: EIP-3009 USDC authorizations with facilitator verification',
        'Single payment-gate middleware over a typed service catalog, with per-route unit-economics tracking',
        'Agent-native discovery (OpenAPI, llms.txt); deployed on Cloudflare Workers + D1 via IaC',
      ]}
      stack={['x402', 'USDC', 'Hono', 'Cloudflare Workers', 'Cloudflare D1', 'Drizzle']}
      websiteUrl="https://1cent.sivaram.dev"
    />
    <Project
      title="varam.chat"
      iconUrl="/projects/icons/varam-chat.png"
      status="Invite-only"
      image={varamChatImg}
      description="A live, self-hosted multi-model AI chat platform routing 23 models through OpenRouter. Production plumbing throughout, running daily."
      highlights={[
        'Every response persists full inference telemetry (token usage, TTFT, tokens/sec, provider metadata) to Postgres as an auditable usage trail',
        'Price-floor cost routing with flex service tiers, and resumable Redis-backed streams that survive client disconnects',
        'Sandboxed agentic tool execution (code sandbox, web search, docs retrieval) and atomic Lua-scripted rate limiting',
      ]}
      stack={[
        'OpenRouter',
        'AI SDK',
        'TanStack Start',
        'Postgres', 'Drizzle',
        'Redis',
        'E2B',
      ]}
      websiteUrl="https://varam-chat.sivaramp.com"
      websiteLabel="Live Site"
    />
    <Project
      title="Varam Analytics"
      iconUrl="/projects/icons/varam-analytics.png"
      status="Invite-only"
      image={varamAnalyticsImg}
      description="Self-hosted, cookieless web analytics, running in production and powering the analytics on this very site."
      highlights={[
        'Dependency-free tracker script, Bun/Hono event collector, and a TimescaleDB event store',
        'Ingestion with Redis rate limiting, sequence-based deduplication, and realtime visitors via sliding-window sorted sets',
        'Hypertables with compression, retention policies, and continuous aggregates precomputing bounce rate, session duration, and scroll depth',
      ]}
      stack={['Bun', 'Hono', 'TimescaleDB', 'Redis', 'Drizzle', 'Railway']}
      websiteUrl="https://varam-analytics.sivaramp.com"
      websiteLabel="Live Service"
    />
    <Project
      title="Sentinel3"
      status="Prototype"
      statuses={['EVM']}
      image={sentinel3Img}
      description="A pay-per-audit security service for Solidity contracts: submit a repo, get a verified findings report. Built end to end as a working prototype, never launched commercially."
      highlights={[
        'A consensus pipeline rather than a single model call: four analysis agents run in parallel, three jurors then vote on every candidate finding, and only deadlocked findings escalate to a judge model',
        'Six static-analysis tools (Slither, Aderyn, Mythril, Echidna, Solhint, Surya) run alongside Foundry in purpose-built e2b sandboxes, so their output grounds the model rather than the reverse',
        'Benchmarked against the SmartBugs Curated dataset with vulnerability annotations and suggestive filenames stripped first, to keep the models from reading the answers off the contracts',
      ]}
      stack={[
        'OpenRouter',
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'Redis',
        'Next.js',
        'Bun',
      ]}
    />
    <Project
      title="Signal Brief"
      status="Internal Tooling"
      iconUrl="/projects/icons/signal-brief.png"
      image={signalBriefImg}
      description="A cost-aware, multi-source LLM research pipeline over X, Reddit & Hacker News, at ~$1/day all-in."
      highlights={[
        'A cheap-model triage gate scores every candidate before any paid scrape or frontier-model call is spent',
        "Every run reconciled against the provider's actual billing ledger, not estimates",
        'Parallel per-source fan-out with cross-platform corroboration, citation-backed daily digests, and one-click publishing to dev.to',
      ]}
      stack={[
        'OpenRouter',
        'Postgres', 'Drizzle',
        'Firecrawl',
        'TanStack Start',
      ]}
      websiteUrl="https://dev.to/sivarampg"
      websiteLabel="Live Output"
    />
  </div>
</section>
