---
import oneCentImg from '../../assets/projects/1cent.png'
import sentinel3Img from '../../assets/projects/sentinel3.png'
import inferplaneImg from '../../assets/projects/inferplane.png'
import signalBriefImg from '../../assets/projects/signal-brief.webp'
import stackfightImg from '../../assets/projects/stackfight.png'
import varamAnalyticsImg from '../../assets/projects/varam-analytics.png'
import varamChatImg from '../../assets/projects/varam-chat.png'
import Project from '../Project.astro'
import SectionTitle from '../SectionTitle.astro'
---

<section class="flex flex-col gap-4 sm:gap-6">
  <SectionTitle title="Featured Work" />
  <div class="flex flex-col divide-y divide-gray-200 dark:divide-gray-800 [&>*]:py-8 [&>*:first-child]:pt-0 [&>*:last-child]:pb-0">
    <Project
      title="InferPlane"
      iconUrl="/projects/icons/inferplane.png"
      image={inferplaneImg}
      status="In Stealth"
      description="An AI control plane for teams: governed model access, credit metering, retained LLM request logs, and audit trails across providers. Currently building in stealth."
      highlights={[
        'Append-only credits ledger with reservation/settlement lifecycle and idempotency guarantees',
        'OTLP ingestion of provider usage telemetry, with request/response artifacts archived to object storage',
        'Hardened Hono/oRPC API with org-scoped rate limiting; the control plane comes before the product surface',
      ]}
      stack={[
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'Redis',
        'Trigger.dev',
        'Stripe',
        'Cloudflare',
      ]}
    />
    <Project
      title="stackfight"
      iconUrl="/projects/icons/stackfight.png"
      image={stackfightImg}
      description="A credit-billing & AI-usage-metering platform on Cloudflare Workers, exercised in production by live agent-vs-agent games."
      highlights={[
        'Stripe-funded prepaid wallets with fail-closed webhook fulfillment and idempotent integer-microcredit ledger writes',
        'Per-call inference metering with budget-capped OpenRouter keys and automated ledger reconciliation',
        'Financial invariant auditing (balance floors, ledger conservation), an extensive test suite, and rigorous ops documentation',
      ]}
      stack={[
        'Cloudflare Workers',
        'Durable Objects',
        'Stripe',
        'OpenRouter',
        'Postgres', 'Drizzle',
      ]}
      websiteUrl="https://stackfight.sivaram.dev"
    />
    <Project
      title="1-cent-requests"
      iconUrl="/projects/icons/1cent.png"
      image={oneCentImg}
      description="A live x402 pay-per-request API marketplace: 14 crypto/web-context endpoints for AI agents at $0.01 each, settled in USDC through signed HTTP 402 exchanges. No accounts, no API keys."
      highlights={[
        'Full x402 v2 resource-server implementation: EIP-3009 USDC authorizations with facilitator verification',
        'Single payment-gate middleware over a typed service catalog, with per-route unit-economics tracking',
        'Agent-native discovery (OpenAPI, llms.txt); deployed on Cloudflare Workers + D1 via IaC',
      ]}
      stack={['x402', 'USDC', 'Hono', 'Cloudflare Workers', 'Cloudflare D1', 'Drizzle']}
      websiteUrl="https://1cent.sivaram.dev"
    />
    <Project
      title="varam.chat"
      iconUrl="/projects/icons/varam-chat.png"
      status="Invite-only"
      image={varamChatImg}
      description="A live, self-hosted multi-model AI chat platform routing 23 models through OpenRouter. Production plumbing throughout, running daily."
      highlights={[
        'Every response persists full inference telemetry (token usage, TTFT, tokens/sec, provider metadata) to Postgres as an auditable usage trail',
        'Price-floor cost routing with flex service tiers, and resumable Redis-backed streams that survive client disconnects',
        'Sandboxed agentic tool execution (code sandbox, web search, docs retrieval) and atomic Lua-scripted rate limiting',
      ]}
      stack={[
        'OpenRouter',
        'AI SDK',
        'TanStack Start',
        'Postgres', 'Drizzle',
        'Redis',
        'E2B',
      ]}
      websiteUrl="https://varam-chat.sivaramp.com"
      websiteLabel="Live Site"
    />
    <Project
      title="Varam Analytics"
      iconUrl="/projects/icons/varam-analytics.png"
      status="Invite-only"
      image={varamAnalyticsImg}
      description="Self-hosted, cookieless web analytics, running in production and powering the analytics on this very site."
      highlights={[
        'Dependency-free tracker script, Bun/Hono event collector, and a TimescaleDB event store',
        'Ingestion with Redis rate limiting, sequence-based deduplication, and realtime visitors via sliding-window sorted sets',
        'Hypertables with compression, retention policies, and continuous aggregates precomputing bounce rate, session duration, and scroll depth',
      ]}
      stack={['Bun', 'Hono', 'TimescaleDB', 'Redis', 'Drizzle', 'Railway']}
      websiteUrl="https://varam-analytics.sivaramp.com"
      websiteLabel="Live Service"
    />
    <Project
      title="Sentinel3"
      status="Prototype"
      statuses={['EVM']}
      image={sentinel3Img}
      description="A pay-per-audit security service for Solidity contracts: submit a repo, get a verified findings report. Built end to end as a working prototype, never launched commercially."
      highlights={[
        'A consensus pipeline rather than a single model call: four analysis agents run in parallel, three jurors then vote on every candidate finding, and only deadlocked findings escalate to a judge model',
        'Six static-analysis tools (Slither, Aderyn, Mythril, Echidna, Solhint, Surya) run alongside Foundry in purpose-built e2b sandboxes, so their output grounds the model rather than the reverse',
        'Benchmarked against the SmartBugs Curated dataset with vulnerability annotations and suggestive filenames stripped first, to keep the models from reading the answers off the contracts',
      ]}
      stack={[
        'OpenRouter',
        'Hono',
        'oRPC',
        'Postgres', 'Drizzle',
        'Redis',
        'Next.js',
        'Bun',
      ]}
    />
    <Project
      title="Signal Brief"
      status="Internal Tooling"
      iconUrl="/projects/icons/signal-brief.png"
      image={signalBriefImg}
      description="A cost-aware, multi-source LLM research pipeline over X, Reddit & Hacker News, at ~$1/day all-in."
      highlights={[
        'A cheap-model triage gate scores every candidate before any paid scrape or frontier-model call is spent',
        "Every run reconciled against the provider's actual billing ledger, not estimates",
        'Parallel per-source fan-out with cross-platform corroboration, citation-backed daily digests, and one-click publishing to dev.to',
      ]}
      stack={[
        'OpenRouter',
        'Postgres', 'Drizzle',
        'Firecrawl',
        'TanStack Start',
      ]}
      websiteUrl="https://dev.to/sivarampg"
      websiteLabel="Live Output"
    />
  </div>
</section>
