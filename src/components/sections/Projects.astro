---
import Project from '../Project.astro'
import SectionTitle from '../SectionTitle.astro'
---

<section class="flex flex-col gap-2 sm:gap-4">
  <SectionTitle title="Featured Work" />
  <div class="flex flex-col gap-8">
    <Project
      title="InferPlane"
      status="In Stealth"
      description={`An AI control plane for teams — governed model access, credit metering, retained LLM request logs, and audit trails across providers. Currently building in stealth.\nArchitecture-first: an append-only credits ledger with reservation/settlement lifecycle and idempotency guarantees, OTLP ingestion of provider usage telemetry with request/response artifacts archived to object storage, and a hardened Hono/oRPC API with org-scoped rate limiting. The control plane comes before the product surface — more soon.`}
      stack={[
        'Hono',
        'oRPC',
        'Postgres / Drizzle',
        'Redis',
        'Trigger.dev',
        'Stripe',
        'Cloudflare',
      ]}
    />
    <Project
      title="stackfight"
      description={`A credit-billing & AI-usage-metering platform on Cloudflare Workers: Stripe-funded prepaid wallets, per-call inference metering with budget-capped OpenRouter keys, and automated ledger reconciliation — exercised in production by live agent-vs-agent games.\nFail-closed Stripe webhook fulfillment with idempotent integer-microcredit ledger writes, financial invariant auditing (balance floors, ledger conservation), 192 tests across 34 files, and ~2.5k lines of architecture & ops docs.`}
      stack={[
        'Cloudflare Workers',
        'Durable Objects',
        'Stripe',
        'OpenRouter',
        'Postgres / Drizzle',
      ]}
      websiteUrl="https://stackfight.sivaram.dev"
      repoUrl="https://github.com/SivaramPg/agent-vs-agent-poker-platform"
    />
    <Project
      title="1-cent-requests"
      description={`A live x402 pay-per-request API marketplace: 14 crypto/web-context endpoints for AI agents at $0.01 each, settled in USDC through signed HTTP 402 exchanges — no accounts, no API keys.\nFull x402 v2 resource-server implementation (EIP-3009 USDC authorizations, facilitator verification) as a single payment-gate middleware over a typed service catalog, with agent-native discovery (OpenAPI, llms.txt) and per-route unit-economics tracking. Deployed on Cloudflare Workers + D1 via IaC.`}
      stack={['x402', 'USDC', 'Hono', 'Cloudflare Workers', 'D1 / Drizzle']}
      websiteUrl="https://1cent.sivaram.dev"
      repoUrl="https://github.com/SivaramPg/1-cent-requests"
    />
    <Project
      title="varam.chat"
      status="Invite-only"
      description={`A live, self-hosted multi-model AI chat platform routing 23 models through OpenRouter — every response persists full inference telemetry (token usage, TTFT, tokens/sec, provider metadata) to Postgres as an auditable usage trail.\nPrice-floor cost routing with flex service tiers, resumable Redis-backed streams that survive client disconnects, sandboxed agentic tool execution (code sandbox, web search, docs retrieval), and atomic Lua-scripted rate limiting. 500+ commits of production plumbing, running daily.`}
      stack={[
        'OpenRouter',
        'AI SDK',
        'TanStack Start',
        'Postgres / Drizzle',
        'Redis',
        'E2B',
      ]}
      websiteUrl="https://varam-chat.sivaramp.com"
      websiteLabel="Live Site"
    />
    <Project
      title="Varam Analytics"
      description={`Self-hosted, cookieless web analytics: a dependency-free tracker script, a Bun/Hono event collector, and a TimescaleDB store — running in production and powering the analytics on this very site.\nIngestion with Redis rate limiting and sequence-based deduplication, realtime visitor tracking via sliding-window sorted sets, and TimescaleDB hypertables with compression, retention policies, and continuous aggregates precomputing bounce rate, session duration, and scroll depth.`}
      stack={['Bun', 'Hono', 'TimescaleDB', 'Redis', 'Drizzle', 'Railway']}
      websiteUrl="https://varam-analytics.sivaramp.com"
      websiteLabel="Live Service"
    />
    <Project
      title="Signal Brief"
      description={`A cost-aware, multi-source LLM research pipeline over X, Reddit & Hacker News. A cheap-model triage gate scores every candidate before any paid scrape or frontier-model call is spent, and every run is reconciled against the provider's actual billing ledger — ~$1/day all-in.\nParallel per-source fan-out with cross-platform corroboration, citation-backed daily digests, and one-click publishing to dev.to.`}
      stack={[
        'OpenRouter',
        'Postgres / Drizzle',
        'Firecrawl',
        'TanStack Start',
      ]}
      websiteUrl="https://dev.to/sivarampg"
      websiteLabel="Live Output"
    />
  </div>
</section>
