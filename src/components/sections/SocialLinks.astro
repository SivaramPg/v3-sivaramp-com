    <img
      src="/icons/x.svg"
      alt="X (Twitter)"
      class="w-6 dark:invert"
      loading="eager"
      width="24"
      height="24"
    />
  </a>
  <a
    target="_blank"
    href="mailto:dev.sivaramp@gmail.com"
    class="border border-gray-300 dark:border-gray-700 rounded flex gap-3 items-center justify-center p-2 sm:p-3 bg-gray-50 dark:bg-gray-900 hover:shadow-md dark:hover:bg-gray-800 duration-100"
  >
    <img
      src="/icons/email.svg"
      alt="Email Address"
      class="w-6 dark:invert"
      loading="eager"
      width="24"
      height="24"
    />
    <p class="font-semibold">Contact Me</p>
  </a>
