---
import { Icon } from 'astro-icon/components'
---

<section class="flex gap-2 sm:gap-3 items-center flex-wrap">
  <a
    target="_blank"
    href="https://github.com/SivaramPg"
    class="border border-gray-300 dark:border-gray-700 rounded flex gap-3 items-center justify-center p-2 sm:p-3 bg-gray-50 dark:bg-gray-900 hover:shadow-md dark:hover:bg-gray-800 duration-100"
  >
    <img
      src="/icons/github.svg"
      alt="Github"
      class="w-6 dark:invert"
      loading="eager"
      width="24"
      height="24"
    />
  </a>
  <a
    target="_blank"
    href="https://www.linkedin.com/in/sivaram-pandariganthan-b753a2145/"
    class="border border-gray-300 dark:border-gray-700 rounded flex gap-3 items-center justify-center p-2 sm:p-3 bg-gray-50 dark:bg-gray-900 hover:shadow-md dark:hover:bg-gray-800 duration-100"
  >
    <img
      src="/icons/linkedin.svg"
      alt="LinkedIn"
      class="w-6 dark:invert"
      loading="eager"
      width="24"
      height="24"
    />
  </a>
  <a
    target="_blank"
    href="https://blog.sivaramp.com/"
    aria-label="Blog"
    class="border border-gray-300 dark:border-gray-700 rounded flex gap-3 items-center justify-center p-2 sm:p-3 bg-gray-50 dark:bg-gray-900 hover:shadow-md dark:hover:bg-gray-800 duration-100"
  >
    <Icon name="lucide:rss" class="w-6 h-6 text-black dark:text-white" />
  </a>
  <a
    target="_blank"
    href="https://sivarampg.medium.com/"
    class="border border-gray-300 dark:border-gray-700 rounded flex gap-3 items-center justify-center p-2 sm:p-3 bg-gray-50 dark:bg-gray-900 hover:shadow-md dark:hover:bg-gray-800 duration-100"
  >
    <img
      src="/icons/medium.svg"
      alt="Medium"
      class="w-6 dark:invert"
      loading="eager"
      width="24"
      height="24"
    />
  </a>
  <a
    target="_blank"
    href="https://x.com/SivaramPg"
    class="border border-gray-300 dark:border-gray-700 rounded flex gap-3 items-center justify-center p-2 sm:p-3 bg-gray-50 dark:bg-gray-900 hover:shadow-md dark:hover:bg-gray-800 duration-100"
