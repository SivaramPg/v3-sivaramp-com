---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import About from '../components/sections/About.astro'
import ClientWork from '../components/sections/ClientWork.astro'
import CTA from '../components/sections/CTA.astro'
import Divider from '../components/Divider.astro'
import Lightbox from '../components/Lightbox.astro'
import Education from '../components/sections/Education.astro'
import Experience from '../components/sections/Experience.astro'
import LongBio from '../components/sections/LongBio.astro'
import OpenSource from '../components/sections/OpenSource.astro'
import Projects from '../components/sections/Projects.astro'
import WorkExperience from '../components/sections/WorkExperience.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.ico" />

    <link
      rel="preload"
      href="/fonts/AtkinsonHyperlegibleNext-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/FunnelDisplay-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Full-stack product engineer with 8+ years across AI platforms, crypto & payment systems, smart contracts (EVM, Solana), analytics infrastructure, mobile apps, and developer tools. I design, build, deploy, and operate complete products end to end."
    />
    <meta
      name="og:title"
      content="Sivaram Pandariganthan | Full-Stack Product Engineer · AI, Crypto & Web"
    />
    <meta
      name="og:description"
      content="Full-stack product engineer with 8+ years across AI platforms, crypto & payment systems, smart contracts (EVM, Solana), analytics infrastructure, mobile apps, and developer tools. I design, build, deploy, and operate complete products end to end."
    />
    <meta
      name="twitter:title"
      content="Sivaram Pandariganthan | Full-Stack Product Engineer · AI, Crypto & Web"
    />
    <meta
      name="twitter:description"
      content="Full-stack product engineer with 8+ years across AI platforms, crypto & payment systems, smart contracts (EVM, Solana), analytics infrastructure, mobile apps, and developer tools. I design, build, deploy, and operate complete products end to end."
    />
    <meta
      name="image"
      property="og:image"
      content="https://sivaramp.com/me.jpg"
    />
    <meta
      name="image"
      property="twitter:image"
      content="https://sivaramp.com/me.jpg"
    />
    <meta property="og:type" content="website" />
    <meta name="author" content="Sivaram Pandariganthan" />
    <meta property="og:url" content="https://sivaramp.com" />

    <title>Sivaram Pandariganthan | Full-Stack Product Engineer · AI, Crypto & Web</title>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Sivaram Pandariganthan',
        url: 'https://sivaramp.com',
        image: 'https://sivaramp.com/me.jpg',
        jobTitle: 'Full-Stack Product Engineer',
        description:
          'Full-stack product engineer building AI platforms, crypto & payment systems, smart contracts, analytics infrastructure, mobile apps, and developer tools.',
        email: 'mailto:dev.sivaramp@gmail.com',
        sameAs: [
          'https://blog.sivaramp.com/',
          'https://github.com/SivaramPg',
          'https://www.linkedin.com/in/sivaram-pandariganthan-b753a2145/',
          'https://x.com/SivaramPg',
          'https://sivarampg.medium.com/',
          'https://dev.to/sivarampg',
        ],
        knowsAbout: [
          'AI infrastructure',
          'LLM applications',
          'Payments & billing systems',
          'Usage metering & reconciliation',
          'Smart contracts (Solidity, Rust, Solana)',
          'Cloudflare Workers',
          'React & Next.js',
          'Flutter',
          'Self-hosted analytics',
          'Developer tools',
        ],
      })}
    />

    {import.meta.env.PROD ? (
      <script
        src="https://varam-analytics.sivaramp.com/scripts/gojo.js"
        is:inline
      />
    ) : (
      <script
        src="https://varam-analytics.sivaramp.com/scripts/sukuna.js"
        data-debug="sivaramp.com"
        is:inline
      />
    )}

    <style is:global>
      body {
        transition:
          background-color 150ms linear,
          color 150ms linear;
      }
      @font-face {
        font-family: 'Atkinson Hyperlegible Next';
        src: url('/fonts/AtkinsonHyperlegibleNext-Variable.woff2')
          format('woff2');
        font-weight: 200 800;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Funnel Display';
        src: url('/fonts/FunnelDisplay-Variable.woff2') format('woff2');
        font-weight: 300 800;
        font-style: normal;
        font-display: swap;
      }
    </style>
  </head>
  <body
    class="bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 w-full min-h-screen"
  >
    <main
      class="w-full max-w-5xl mx-auto min-h-screen py-6 sm:py-10 md:py-14 lg:py-20 px-4 flex flex-col gap-6 sm:gap-8 md:gap-12 relative"
    >
      <About />
      <LongBio />
      <Divider />
      <Projects />
      <Divider />
      <ClientWork />
      <Divider />
      <WorkExperience />
      <Divider />
      <Experience />
      <Divider />
      <OpenSource />
      <Divider />
      <Education />
      <CTA />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>
